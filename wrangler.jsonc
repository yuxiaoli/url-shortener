{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vectorindex-short-links",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"PUBLIC_ORIGIN": "https://s.vectorindex.cloud"},
  "kv_namespaces": [{"binding": "LINKS", "id": "REPLACE_WITH_DEDICATED_NAMESPACE_ID"}]
}
